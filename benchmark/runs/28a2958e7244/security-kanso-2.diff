+
+test("a document of another tenant is indistinguishable from a missing one", () => {
+  const expected = new NotFoundError("document 42 not found");
+  assert.throws(() => readDocument([shared[0]], { tenantId: "a" }, 42), expected);
+  assert.throws(() => readDocument([], { tenantId: "a" }, 42), expected);
+});
+
+test("finds the caller's document when ids collide across tenants", () => {
+  assert.equal(readDocument(shared, { tenantId: "a" }, 42).title, "Mine");
+});
+
+test("a caller without a tenant reads nothing", () => {
+  for (const caller of [{}, { tenantId: null }, { tenantId: "" }, null, undefined]) {
