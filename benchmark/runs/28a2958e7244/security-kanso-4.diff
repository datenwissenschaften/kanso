diff --git a/src/documents.mjs b/src/documents.mjs
index 74b966e..da2d687 100644
--- a/src/documents.mjs
+++ b/src/documents.mjs
@@ -2,7 +2,10 @@ export class NotFoundError extends Error {}
 
 // Returns the document with `id` for an authenticated caller ({ tenantId }).
 export function readDocument(documents, caller, id) {
-  const document = documents.find((candidate) => candidate.id === id);
+  const tenantId = caller?.tenantId;
+  const document = tenantId
+    ? documents.find((candidate) => candidate.id === id && candidate.tenantId === tenantId)
+    : undefined;
   if (!document) throw new NotFoundError(`document ${id} not found`);
   return document;
 }
diff --git a/test/documents.test.mjs b/test/documents.test.mjs
index 3d56fe9..6f7e86e 100644
--- a/test/documents.test.mjs
+++ b/test/documents.test.mjs
@@ -1,8 +1,40 @@
 import assert from "node:assert/strict";
 import test from "node:test";
-import { readDocument } from "../src/documents.mjs";
+import { NotFoundError, readDocument } from "../src/documents.mjs";
 
 test("reads a document of the caller's tenant", () => {
   const documents = [{ id: 1, tenantId: "a", title: "Plan" }];
   assert.equal(readDocument(documents, { tenantId: "a" }, 1).title, "Plan");
 });
+
+const other = [{ id: 42, tenantId: "b", title: "Secret" }];
+const messageFor = (documents, caller, id) => {
+  try {
+    readDocument(documents, caller, id);
+  } catch (error) {
+    assert.ok(error instanceof NotFoundError);
+    return error.message;
+  }
+  assert.fail("expected NotFoundError");
+};
+
+test("another tenant's document is indistinguishable from a missing one", () => {
+  assert.equal(
+    messageFor(other, { tenantId: "a" }, 42),
+    messageFor([], { tenantId: "a" }, 42),
+  );
+});
+
+test("finds the caller's document when another tenant reuses the id", () => {
+  const documents = [...other, { id: 42, tenantId: "a", title: "Mine" }];
+  assert.equal(readDocument(documents, { tenantId: "a" }, 42).title, "Mine");
+});
+
+test("a caller without a tenant reads nothing", () => {
+  const untenanted = [{ id: 1, title: "Orphan" }, { id: 2, tenantId: null }];
+  for (const caller of [{}, { tenantId: null }, { tenantId: "" }, null, undefined]) {
+    for (const id of [1, 2, 42]) {
+      assert.throws(() => readDocument([...untenanted, ...other], caller, id), NotFoundError);
+    }
+  }
+});
