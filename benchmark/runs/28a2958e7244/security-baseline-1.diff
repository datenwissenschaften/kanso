+import { NotFoundError, readDocument } from "../src/documents.mjs";
+
+test("other tenants' and missing documents are indistinguishable", () => {
+  const documents = [{ id: 42, tenantId: "b", title: "Secret" }];
+  const message = (caller, id) => {
+    try {
+      readDocument(documents, caller, id);
+    } catch (error) {
+      assert.ok(error instanceof NotFoundError);
+      return error.message.replace(String(id), "");
+    }
+    assert.fail("expected NotFoundError");
+  };
+  assert.equal(message({ tenantId: "a" }, 42), message({ tenantId: "a" }, 7));
+});
+
+test("a caller without a tenant reads nothing", () => {
+  const documents = [{ id: 1, title: "Orphan" }, { id: 2, tenantId: "b" }];
+  for (const caller of [{}, { tenantId: null }, { tenantId: "" }, undefined]) {
+    for (const id of [1, 2]) {
+      assert.throws(() => readDocument(documents, caller, id), NotFoundError);
+    }
+  }
+});
+
+test("same id in several tenants resolves to the caller's own", () => {
+  const documents = [
+    { id: 42, tenantId: "b", title: "B" },
+    { id: 42, tenantId: "a", title: "A" },
+  ];
+  assert.equal(readDocument(documents, { tenantId: "a" }, 42).title, "A");
+});
 
