-import { readDocument } from "../src/documents.mjs";
+import { NotFoundError, readDocument } from "../src/documents.mjs";
+
+const docs = [
+  { id: 42, tenantId: "b", title: "Secret" },
+  { id: 42, tenantId: "a", title: "Mine" },
+  { id: 7, title: "Unowned" },
+];
+
+test("cross-tenant read is indistinguishable from missing", () => {
+  const only = [docs[0]];
+  let foreign, missing;
+  try { readDocument(only, { tenantId: "a" }, 42); } catch (e) { foreign = e; }
+  try { readDocument(only, { tenantId: "a" }, 99); } catch (e) { missing = e; }
+  assert.ok(foreign instanceof NotFoundError);
+  assert.equal(foreign.message.replace("42", "X"), missing.message.replace("99", "X"));
+});
+
+test("same id in two tenants returns the caller's own", () => {
+  assert.equal(readDocument(docs, { tenantId: "a" }, 42).title, "Mine");
+});
+
+test("caller without a tenant reads nothing", () => {
+  for (const caller of [{}, { tenantId: undefined }, null, undefined]) {
+    assert.throws(() => readDocument(docs, caller, 7), NotFoundError);
+    assert.throws(() => readDocument(docs, caller, 42), NotFoundError);
+  }
+});
 
