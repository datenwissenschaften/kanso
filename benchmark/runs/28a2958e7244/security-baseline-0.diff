diff --git a/src/documents.mjs b/src/documents.mjs
index 74b966e..8081b2b 100644
--- a/src/documents.mjs
+++ b/src/documents.mjs
@@ -2,7 +2,11 @@ export class NotFoundError extends Error {}
 
 // Returns the document with `id` for an authenticated caller ({ tenantId }).
 export function readDocument(documents, caller, id) {
-  const document = documents.find((candidate) => candidate.id === id);
+  const tenantId = caller?.tenantId;
+  const hasTenant = tenantId !== undefined && tenantId !== null && tenantId !== "";
+  const document = hasTenant
+    ? documents.find((candidate) => candidate.id === id && candidate.tenantId === tenantId)
+    : undefined;
   if (!document) throw new NotFoundError(`document ${id} not found`);
   return document;
 }
diff --git a/test/documents.test.mjs b/test/documents.test.mjs
index 3d56fe9..6a68a67 100644
--- a/test/documents.test.mjs
+++ b/test/documents.test.mjs
@@ -1,8 +1,30 @@
 import assert from "node:assert/strict";
 import test from "node:test";
-import { readDocument } from "../src/documents.mjs";
+import { NotFoundError, readDocument } from "../src/documents.mjs";
 
 test("reads a document of the caller's tenant", () => {
   const documents = [{ id: 1, tenantId: "a", title: "Plan" }];
   assert.equal(readDocument(documents, { tenantId: "a" }, 1).title, "Plan");
 });
+
+test("other tenant's document is indistinguishable from a missing one", () => {
+  const documents = [{ id: 42, tenantId: "b", title: "Secret" }];
+  assert.throws(() => readDocument(documents, { tenantId: "a" }, 42), NotFoundError);
+  assert.throws(() => readDocument(documents, { tenantId: "a" }, 7), NotFoundError);
+});
+
+test("same id in two tenants resolves to the caller's own", () => {
+  const documents = [
+    { id: 42, tenantId: "b", title: "B" },
+    { id: 42, tenantId: "a", title: "A" },
+  ];
+  assert.equal(readDocument(documents, { tenantId: "a" }, 42).title, "A");
+});
+
+test("caller without a tenant reads nothing", () => {
+  const documents = [{ id: 1, title: "Orphan" }, { id: 2, tenantId: "a" }];
+  for (const caller of [{}, { tenantId: null }, undefined, null]) {
+    assert.throws(() => readDocument(documents, caller, 1), NotFoundError);
+    assert.throws(() => readDocument(documents, caller, 2), NotFoundError);
+  }
+});
