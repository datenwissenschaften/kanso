-import { readDocument } from "../src/documents.mjs";
+import { NotFoundError, readDocument } from "../src/documents.mjs";
+
+const foreign = [{ id: 42, tenantId: "b", title: "Secret" }];
+
+test("a foreign tenant's document is reported as not found", () => {
+  assert.throws(() => readDocument(foreign, { tenantId: "a" }, 42), NotFoundError);
+});
+
+test("a foreign document looks identical to a missing one", () => {
+  const message = (documents) => {
+    try {
+      readDocument(documents, { tenantId: "a" }, 42);
+    } catch (error) {
+      return error.message;
+    }
+  };
+  assert.equal(message(foreign), message([]));
+});
+
+test("the caller's own document is found when another tenant reuses the id", () => {
+  const documents = [...foreign, { id: 42, tenantId: "a", title: "Mine" }];
+  assert.equal(readDocument(documents, { tenantId: "a" }, 42).title, "Mine");
+});
+
+test("a caller without a tenant reads nothing", () => {
+  const untenanted = [{ id: 1, title: "Orphan" }, ...foreign];
+  for (const caller of [{}, { tenantId: undefined }, { tenantId: null }, { tenantId: "" }, null, undefined]) {
+    assert.throws(() => readDocument(untenanted, caller, 1), NotFoundError);
+    assert.throws(() => readDocument(untenanted, caller, 42), NotFoundError);
+  }
+});
 
